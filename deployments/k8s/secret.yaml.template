# File: deployments/k8s/secret.yaml.template
# Kubernetes Secret template for sensitive data
# IMPORTANT: Populate with actual values using: kubectl create secret generic llm-gateway-secrets --from-literal=OPENAI_API_KEY=your_key --from-literal=ANTHROPIC_API_KEY=your_key --from-literal=POSTGRES_DSN=your_dsn

apiVersion: v1
kind: Secret
metadata:
  name: llm-gateway-secrets
type: Opaque
stringData:
  OPENAI_API_KEY: "sk-..."
  ANTHROPIC_API_KEY: "sk-ant-..."
  POSTGRES_DSN: "postgres://gateway:gateway@postgres:5432/llmgateway?sslmode=disable"
  REDIS_ADDR: "redis:6379"
  GATEWAY_API_KEYS: "key1,key2,key3"
