# === REQUIRED — Server will panic if missing ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
POSTGRES_DSN=postgres://gateway:gateway@localhost:5432/llmgateway?sslmode=disable
REDIS_ADDR=localhost:6379

# === OPTIONAL — Server Configuration ===
GATEWAY_PORT=8080
GATEWAY_API_KEYS=key1,key2,key3         # Comma-separated valid API keys for auth
GATEWAY_RATE_LIMIT_RPS=100              # Requests per second per team
GATEWAY_RATE_LIMIT_BURST=20             # Token bucket burst size

# === OPTIONAL — Semantic Cache Configuration ===
SIMILARITY_THRESHOLD=0.92               # Semantic cache hit threshold (float, 0-1)
SIMPLE_TOKEN_THRESHOLD=50               # Tokens below this = simple complexity
COMPLEX_TOKEN_THRESHOLD=300             # Tokens above this = complex complexity

# === OPTIONAL — Model Routing ===
DEFAULT_MODEL=groq/llama-3.3-70b-versatile  # Fallback if routing fails

# === OPTIONAL — Embedding Configuration ===
EMBEDDING_BASE_URL=                     # e.g., http://localhost:11434/v1 for Ollama
EMBEDDING_MODEL=text-embedding-3-small  # OpenAI embedding model (or nomic-embed-text for Ollama)
EMBEDDING_BATCH_SIZE=20                 # Max prompts per embedding API call
EMBEDDING_BATCH_TIMEOUT_MS=50           # Max wait time before flushing batch

# === OPTIONAL — Observability ===
PROMETHEUS_PORT=9090
LOG_LEVEL=info                          # debug | info | warn | error
LOG_FORMAT=json                         # json | text

# === OPTIONAL — Dashboard ===
DASHBOARD_PORT=8000

# === OPTIONAL — Database Pool ===
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2

# === OPTIONAL — PII Redaction ===
REDACTION_ENABLED=true               # Master switch. Set false ONLY in dev/test environments.
REDACTION_FAIL_CLOSED=false          # true = block request on redaction error (HIPAA/SOC 2)
                                     # false = log error and pass through unredacted (default)
REDACTION_DISABLED_PATTERNS=         # Comma-separated pattern names to skip.
                                     # Available: url_credentials,api_key,email,credit_card,ssn,phone_us,ipv4
                                     # Example: REDACTION_DISABLED_PATTERNS=ipv4,phone_us


