# === REQUIRED — Server will panic if missing ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
POSTGRES_DSN=postgres://gateway:gateway@localhost:5432/llmgateway?sslmode=disable
REDIS_ADDR=localhost:6379

# === OPTIONAL — Server Configuration ===
GATEWAY_PORT=8080
GATEWAY_API_KEYS=key1,key2,key3         # Comma-separated valid API keys for auth
GATEWAY_RATE_LIMIT_RPS=100              # Requests per second per team
GATEWAY_RATE_LIMIT_BURST=20             # Token bucket burst size

# === OPTIONAL — Semantic Cache Configuration ===
SIMILARITY_THRESHOLD=0.92               # Semantic cache hit threshold (float, 0-1)
SIMPLE_TOKEN_THRESHOLD=50               # Tokens below this = simple complexity
COMPLEX_TOKEN_THRESHOLD=300             # Tokens above this = complex complexity

# === OPTIONAL — Model Routing ===
DEFAULT_MODEL=anthropic/claude-haiku-3  # Fallback if routing fails

# === OPTIONAL — Embedding Configuration ===
EMBEDDING_MODEL=text-embedding-3-small  # OpenAI embedding model
EMBEDDING_BATCH_SIZE=20                 # Max prompts per embedding API call
EMBEDDING_BATCH_TIMEOUT_MS=50           # Max wait time before flushing batch

# === OPTIONAL — Observability ===
PROMETHEUS_PORT=9090
LOG_LEVEL=info                          # debug | info | warn | error
LOG_FORMAT=json                         # json | text

# === OPTIONAL — Dashboard ===
DASHBOARD_PORT=8000

# === OPTIONAL — Database Pool ===
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
